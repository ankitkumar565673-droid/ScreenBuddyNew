# ScreenBuddy Backend Environment Configuration (Level 5)

# Gemini API Key (Required)
# Stored securely on the backend server environment only. Never placed in client code or Android APK.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Gemini Vision Model Configuration (Default: gemini-3.5-flash)
GEMINI_MODEL=gemini-3.5-flash

# Backend Server Port (Default: 8080)
PORT=8080

